    "@nestjs/platform-express": "^11.1.9",
    "@sentry/nestjs": "^10.73.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.25",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.6.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "node-cron": "^4.2.1",
    "puppeteer": "^25.0.4",
    "reflect-metadata": "^0.2.2",
