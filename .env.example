# ==============================================================================
# CHEFU BACKEND ENVIRONMENT CONFIGURATION (.env.example)
#
# Production requirements:
# Required in production:
#   - FRONTEND_ORIGINS, AUTH_SESSION_SECRET (min 32 chars), CHEFU_ACCOUNT_URL
#   - OAUTH_ISSUER, OAUTH_KEY_ID, OAUTH_PRIVATE_KEY (or OAUTH_SIGNING_KEYS_JSON)
#   - FIREBASE_SERVICE_ACCOUNT (or FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY)
#   - FLOW_ACCESS_SECRET
#
# Service requirements (when service is invoked):
#   - Cloudinary: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#   - PayFast: PAYFAST_MERCHANT_ID, PAYFAST_MERCHANT_KEY, PAYFAST_PASSPHRASE
#   - Resend: RESEND_API_KEY
#   - WhatsApp: WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_SYSTEM_USER_TOKEN
#   - Gemini AI: GEMINI_API_KEY
#   - Clerk: CLERK_WEBHOOK_SECRET
# ==============================================================================

# ── Server & Core Settings ──
PORT=4000
NODE_ENV=development

# In development, FRONTEND_ORIGIN or defaults are used. In production, use comma-separated list:
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=https://chefu.co.za,https://myaccount.chefu.co.za,https://academy.chefu.co.za,https://flow.chefu.co.za,https://music.chefu.co.za,https://quantum.chefu.co.za,https://drippybanks.chefu.co.za

# ── Authentication & Session Signing ──
# Required in production. Must be at least 32 characters long.
AUTH_SESSION_SECRET=your_32_character_long_session_signing_secret_here
AUTH_SESSION_MAX_AUTH_AGE_SECONDS=300
AUTH_COOKIE_DOMAIN=
AUDIT_LOG_HASH_SECRET=your_audit_log_hash_secret_here

# Runtime store for distributed rate limits: "firestore" (default) or "memory"
RUNTIME_LIMIT_STORE=firestore
CHEFU_ACCOUNT_URL=https://myaccount.chefu.co.za

# ── OAuth 2.0 & OIDC Authorization Server ──
OAUTH_ISSUER=https://api.chefu.co.za
OAUTH_KEY_ID=chefu-oauth-key-1
# RSA Private Key for RS256 signing (use \n for linebreaks)
OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_pem_here\n-----END PRIVATE KEY-----\n"
# Optional key rotation set
# OAUTH_SIGNING_KEYS_JSON=[{"kid":"2026-06-active","status":"active","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}]
OAUTH_CLOCK_SKEW_SECONDS=60
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_CODE_TTL_MS=300000
OAUTH_DPOP_REQUIRED=false
OAUTH_FAPI_ENFORCED=false
OAUTH_JARM_REQUIRED=false
OAUTH_JARM_TTL_SECONDS=60
OAUTH_ENABLE_REFRESH_TOKENS=false
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_INTERNAL_TOKEN_TTL_SECONDS=300
OAUTH_INTERNAL_AUDIENCES=admin-service,flow-service,muzalo-service,quantum-service
OAUTH_TOKEN_EXCHANGE_CLIENT_IDS=chefu-api-gateway
# OAUTH_M2M_CLIENTS_JSON=
# AUTH_HONEYTOKEN_HASHES=

# ── Firebase Admin SDK ──
# Required: Either provide FIREBASE_SERVICE_ACCOUNT (JSON string or base64) OR individual keys below
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_pem_here\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
FIREBASE_API_KEY=

# ── Cloudinary Media Storage (DrippyBanks & Profile Pictures) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── PayFast Payment Gateway (DrippyBanks Checkout) ──
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=your_payfast_passphrase_here
PAYFAST_SANDBOX=true
DRIPPYBANKS_APP_URL=https://drippybanks.chefu.co.za
BACKEND_PUBLIC_URL=https://api.chefu.co.za

# ── Google Gemini AI ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATE_MODEL=gemini-2.5-flash
AI_MAX_CONTENTS=12
AI_MAX_PARTS_PER_CONTENT=8
AI_MAX_SERIALIZED_CONTENT_BYTES=80000

# ── Meta / WhatsApp Cloud API ──
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_SYSTEM_USER_TOKEN=your_whatsapp_system_user_token_here

# ── Resend Email Service (Template-Based) ──
RESEND_API_KEY=your_resend_api_key_here
SECURITY_EMAIL_FROM="CHEFU Security <security@chefu.co.za>"
NOTIFICATION_EMAIL_FROM="CHEFU Academy <notifications@chefu.co.za>"
SECURITY_EMAIL_FROM_BY_APP=
NOTIFICATION_EMAIL_FROM_BY_APP=

# Resend Template IDs
PASSKEY_ADDED_TEMPLATE_ID=new-passkey-added
SIGNIN_ALERT_TEMPLATE_ID=signin-alert
PASSWORD_CHANGED_TEMPLATE_ID=password-changed
TWO_FACTOR_ENABLED_TEMPLATE_ID=two-factor-enabled
TWO_FACTOR_DISABLED_TEMPLATE_ID=2fa-disabled
API_KEY_COMPROMISED_TEMPLATE_ID=api-key-compromised
WELCOME_PROMO_TEMPLATE_ID=welcome-promo

SIGNIN_ALERT_FROM="CHEFU Security <security@chefu.co.za>"
SIGNIN_ALERT_SECURITY_URL=https://myaccount.chefu.co.za/account
SIGNIN_ALERT_SUPPORT_URL=https://academy.chefu.co.za/support
SIGNIN_ALERT_THROTTLE_MINUTES=360
SIGNIN_ALERT_FINGERPRINT_SECRET=

# ── Flow Mail Service ──
FLOW_API_KEY=your_flow_api_key_here
FLOW_ACCESS_SECRET=your_flow_access_signing_secret_here
FLOW_REGISTERED_KEYS=
FLOW_ACCESS_COOKIE_DOMAIN=
FLOW_DEFAULT_FROM="Flow Mail <mail@chefu.co.za>"
FLOW_EMAIL_TEMPLATE_ID=flow-mail-default
FLOW_SENDERS="CHEFU Technologies <hello@chefu.co.za>;Flow Mail <mail@chefu.co.za>;Support <support@chefu.co.za>;Security <security@chefu.co.za>;Muzalo <muzalo@chefu.co.za>;CHEFU Academy <academy@chefu.co.za>;CHEFU Quantum <quantum@chefu.co.za>"
FLOW_DEFAULT_REPLY_TO="reply@chefu.co.za"
FLOW_INBOUND_ADDRESS=mail@flow.chefu.co.za
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here
FLOW_INBOUND_SECRET=
FLOW_MAX_RECIPIENTS=100

# ── Clerk Billing ──
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here
CLERK_BILLING_PLAN_ID=cplan_3E6vfLRRJBC9t4HfgdUWZJuLPuh
CLERK_BILLING_PRO_PLAN_ID=
CLERK_BILLING_PREMIUM_PLAN_ID=
CLERK_BILLING_PLAN_PERIOD=month
CLERK_BILLING_PORTAL_URL=https://accounts.chefu.co.za/user/billing

# ── Puppeteer & PDF Generation ──
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_NO_SANDBOX=true
COURSE_PDF_MAX_CONCURRENT=2
COURSE_PDF_TIMEOUT_MS=30000
SDK_API_KEY_CLEANUP_CRON=0 0 * * *
ACADEMY_SDK_CATALOG_CACHE_TTL_MS=60000
