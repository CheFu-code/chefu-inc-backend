
# ── Server & Core Settings ──
PORT=4000
NODE_ENV=development

# In development, FRONTEND_ORIGIN or defaults are used. In production, use comma-separated list:
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=https://chefu.co.za,https://myaccount.chefu.co.za,https://academy.chefu.co.za,https://quantum.chefu.co.za

# ── Authentication & Session Signing ──
# Required in production. Must be at least 32 characters long.
AUTH_SESSION_SECRET=your_32_character_long_session_signing_secret_here
AUTH_SESSION_MAX_AUTH_AGE_SECONDS=300
AUTH_COOKIE_DOMAIN=
AUDIT_LOG_HASH_SECRET=your_audit_log_hash_secret_here

# Forwarded headers are ignored unless the immediate proxy is allowlisted.
TRUSTED_PROXY_IPS=
# Optional country detection: cloudflare, vercel, cloudfront, appengine or proxy.
# Leave empty to disable. Requires TRUSTED_PROXY_IPS and a proxy that overwrites
# the selected country header with its own geolocation result, never client input.
COUNTRY_HEADER_PROVIDER=

# In-memory avoids a Firestore read/write per request. Use "firestore" only
# when API rate limits must be shared across multiple backend instances.
# Single-instance development only. For multi-instance production use redis or firestore.
# Redis provides atomic counters and one-shot replay keys without Firestore
# transaction charges. Provision a private TLS-enabled Redis service first.
RUNTIME_LIMIT_STORE=memory
# RUNTIME_LIMIT_STORE=redis
# RUNTIME_LIMIT_REDIS_URL=rediss://user:password@private-redis.example:6379
# Alternatively REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, REDIS_DB.
# Do not enable local fallback in production: distributed storage failures must fail closed.
# RUNTIME_LIMIT_ALLOW_LOCAL_FALLBACK=false
# Optional routine request log sampling: 1=all, 0.1=10% (errors and slow requests are always logged).
# HTTP_SUCCESS_LOG_SAMPLE_RATE=1
CHEFU_ACCOUNT_URL=https://myaccount.chefu.co.za

# ── OAuth 2.0 & OIDC Authorization Server ──
OAUTH_ISSUER=https://api.chefu.co.za
OAUTH_KEY_ID=chefu-oauth-key-1
# RSA Private Key for RS256 signing (use \n for linebreaks)
OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_pem_here\n-----END PRIVATE KEY-----\n"
# Optional key rotation set
# OAUTH_SIGNING_KEYS_JSON=[{"kid":"2026-06-active","status":"active","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}]
OAUTH_CLOCK_SKEW_SECONDS=60
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_CODE_TTL_MS=300000
OAUTH_DPOP_REQUIRED=false
OAUTH_FAPI_ENFORCED=false
OAUTH_JARM_REQUIRED=false
OAUTH_JARM_TTL_SECONDS=60
OAUTH_ENABLE_REFRESH_TOKENS=false
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_INTERNAL_TOKEN_TTL_SECONDS=300
OAUTH_INTERNAL_AUDIENCES=admin-service,quantum-service
OAUTH_TOKEN_EXCHANGE_CLIENT_IDS=chefu-api-gateway
# OAUTH_M2M_CLIENTS_JSON=
# AUTH_HONEYTOKEN_HASHES=

# ── Firebase Admin SDK ──
# Required: Either provide FIREBASE_SERVICE_ACCOUNT (JSON string or base64) OR individual keys below
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_pem_here\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
FIREBASE_API_KEY=

# ── Cloudinary Media Storage (Cloudence & Profile Pictures) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── PayFast Payment Gateway ──
PAYFAST_MERCHANT_ID=your_production_merchant_id_here
PAYFAST_MERCHANT_KEY=your_production_merchant_key_here
PAYFAST_PASSPHRASE=your_production_passphrase_here
BACKEND_PUBLIC_URL=https://api.chefu.co.za

# ShopYethu App Links verification (comma-separated Android SHA-256 fingerprints)
SHOPYETHU_APPLE_TEAM_ID=

# Store checkout (Paystack; independent of the existing PayFast integration).
# Start with a test key. Set the dashboard webhook URL to:
# https://api.chefu.co.za/store/checkout/webhook
PAYSTACK_SECRET_KEY=
# Must match the key and the Paystack dashboard environment.
PAYSTACK_MODE=test
# Set false to pause new checkout creation while verification/workers continue.
STORE_CHECKOUT_ENABLED=false
# Optional fulfillment receiver. It MUST durably deduplicate Idempotency-Key
# and return {"accepted":true,"orderId":"<same-order-reference>"}.
# Without a receiver, fulfillment remains queued for operational review.
STORE_FULFILLMENT_URL=
STORE_FULFILLMENT_TOKEN=
# Current webhook signing secret (whsec_...). When set, legacy signatures are rejected.
# Leave empty only for accounts still using x-paystack-signature with the API secret.
PAYSTACK_WEBHOOK_SECRET=
# Poll pending orders every minute; requires the storeOrders Firestore index.
STORE_RECONCILIATION_ENABLED=true

# ── Google Gemini AI ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATE_MODEL=gemini-2.5-flash
AI_MAX_CONTENTS=12
AI_MAX_PARTS_PER_CONTENT=8
AI_MAX_SERIALIZED_CONTENT_BYTES=80000

# ── Resend Email Service (Template-Based) ──
RESEND_API_KEY=your_resend_api_key_here
CLAMSCAN_PATH=/usr/bin/clamscan
SECURITY_EMAIL_FROM="CHEFU Security <security@chefu.co.za>"
NOTIFICATION_EMAIL_FROM="Chefu Academy <notifications@chefu.co.za>"
SECURITY_EMAIL_FROM_BY_APP=
NOTIFICATION_EMAIL_FROM_BY_APP=

# Resend Template IDs
PASSKEY_ADDED_TEMPLATE_ID=new-passkey-added
SIGNIN_ALERT_TEMPLATE_ID=signin-alert
PASSWORD_CHANGED_TEMPLATE_ID=password-reset-notification
TWO_FACTOR_ENABLED_TEMPLATE_ID=two-factor-enabled
TWO_FACTOR_DISABLED_TEMPLATE_ID=2fa-disabled
API_KEY_COMPROMISED_TEMPLATE_ID=api-key-compromised
WELCOME_PROMO_TEMPLATE_ID=welcome-promo
CAREER_APPLICATION_TEMPLATE_ID=job-application-notification
CAREER_APPLICATION_CONFIRMATION_TEMPLATE_ID=career-application-confirmation

SIGNIN_ALERT_FROM="CHEFU Security <security@chefu.co.za>"
SIGNIN_ALERT_SECURITY_URL=https://myaccount.chefu.co.za/account
SIGNIN_ALERT_THROTTLE_MINUTES=360
SIGNIN_ALERT_FINGERPRINT_SECRET=
    

# ── Puppeteer & PDF Generation ──
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_NO_SANDBOX=true
COURSE_PDF_MAX_CONCURRENT=2
COURSE_PDF_TIMEOUT_MS=30000
SDK_API_KEY_CLEANUP_CRON=0 0 * * *
ACADEMY_SDK_CATALOG_CACHE_TTL_MS=60000



# Phone verification is opt-in. Production requires distributed runtime limits.
PHONE_VERIFICATION_ENABLED=false
PHONE_VERIFICATION_ALLOWED_COUNTRIES=ZA
PHONE_VERIFICATION_DAILY_SEND_LIMIT=100
TWILIO_ACCOUNT_SID=AC...
# Prefer a restricted Verify API key in production; auth-token auth remains supported.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...
