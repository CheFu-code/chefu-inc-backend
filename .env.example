PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Use comma-separated origins in production:
# FRONTEND_ORIGINS=https://chefuinc.com,https://myaccount.chefuinc.com,https://academy.chefuinc.com,https://flow.chefuinc.com,https://music.chefuinc.com,https://quantum.chefuinc.com
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_MAX_AUTH_AGE_SECONDS=300
AUDIT_LOG_HASH_SECRET=replace-with-a-long-random-audit-log-secret
# Use Firestore-backed distributed throttles/replay caches by default.
# Set to "memory" only for isolated local testing.
RUNTIME_LIMIT_STORE=firestore
CHEFU_ACCOUNT_URL=https://myaccount.chefuinc.com
OAUTH_ISSUER=https://api.chefuinc.com
OAUTH_KEY_ID=chefu-oauth-production-key
# Generate an RSA private key for RS256 token signing:
# openssl genrsa -out oauth-private.pem 2048
# Store the PEM content with \n escapes in production.
OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional multi-key rotation set. Exactly one key must be "active"; "next" and
# "retiring" keys stay published in JWKS for zero-downtime rollout.
# OAUTH_SIGNING_KEYS_JSON=[{"kid":"2026-06-active","status":"active","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"},{"kid":"2026-07-next","status":"next","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}]
OAUTH_CLOCK_SKEW_SECONDS=60
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_CODE_TTL_MS=300000
OAUTH_DPOP_REQUIRED=false
OAUTH_FAPI_ENFORCED=false
OAUTH_JARM_REQUIRED=false
OAUTH_JARM_TTL_SECONDS=60
OAUTH_ENABLE_REFRESH_TOKENS=false
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_INTERNAL_TOKEN_TTL_SECONDS=300
OAUTH_INTERNAL_AUDIENCES=admin-service,flow-service,muzalo-service,quantum-service
OAUTH_TOKEN_EXCHANGE_CLIENT_IDS=chefu-api-gateway
# M2M clients use private_key_jwt. Each client has its own JWKS, scopes,
# allowed audiences, and per-client rate limit.
# OAUTH_M2M_CLIENTS_JSON=[{"id":"analytics-agent","jwks":{"keys":[{"kty":"RSA","kid":"agent-2026-06","n":"...","e":"AQAB","alg":"RS256","use":"sig"}]},"allowedScopes":["read:analytics"],"allowedAudiences":["chefu-api"],"rateLimitPerMinute":120}]
# SHA-256 hashes of planted bearer/session/refresh tokens. If any is observed
# at the gateway, the request is blocked and a critical security event is stored.
# AUTH_HONEYTOKEN_HASHES=9b3f...

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=

GEMINI_API_KEY=
GEMINI_GENERATE_MODEL=gemini-2.5-flash
AI_MAX_CONTENTS=12
AI_MAX_PARTS_PER_CONTENT=8
AI_MAX_SERIALIZED_CONTENT_BYTES=80000
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
RESEND_API_KEY=
FLOW_API_KEY=
FLOW_ACCESS_SECRET=replace-with-a-long-random-flow-access-secret
ENFORCE_HTTPS=true
# Optional server-only bootstrap keys, e.g. "Ops:FLOW-OPS-2026,Sales:FLOW-SALES-2026".
# Prefer creating employee keys through POST /flow/admin/access-keys.
FLOW_REGISTERED_KEYS=
# Optional cookie domain in production. Defaults to AUTH_COOKIE_DOMAIN.
FLOW_ACCESS_COOKIE_DOMAIN=
FLOW_DEFAULT_FROM="Flow Mail <mail@chefuinc.com>"
FLOW_EMAIL_TEMPLATE_ID=flow-mail-default
# Flow app access is restricted to these sender email addresses when the
# frontend creates a Flow-marked session.
FLOW_SENDERS="CheFu Inc <hello@chefuinc.com>;Flow Mail <mail@chefuinc.com>;Support <support@chefuinc.com>;Security <security@chefuinc.com>;Muzalo <muzalo@chefuinc.com>;CheFu Academy <academy@chefuinc.com>;CheFu Quantum <quantum@chefuinc.com>"
FLOW_DEFAULT_REPLY_TO="reply@chefuinc.com"
FLOW_INBOUND_ADDRESS=mail@flow.chefuinc.com
# Resend webhook signing secret for /flow/inbound. Prefer this in production.
RESEND_WEBHOOK_SECRET=
# Optional local/manual-test fallback when RESEND_WEBHOOK_SECRET is not set.
FLOW_INBOUND_SECRET=
FLOW_MAX_RECIPIENTS=100
SECURITY_EMAIL_FROM="CheFu Academy <security@chefuinc.com>"
NOTIFICATION_EMAIL_FROM="CheFu Academy <notifications@chefuinc.com>"
NOTIFICATION_EMAIL_TEMPLATE_ID=
SIGNIN_ALERT_FROM="CheFu Academy <security@chefuinc.com>"
SIGNIN_ALERT_TEMPLATE_ID=
PASSWORD_CHANGED_TEMPLATE_ID=
SIGNIN_ALERT_SECURITY_URL=https://myaccount.chefuinc.com/account
SIGNIN_ALERT_SUPPORT_URL=https://academy.chefuinc.com/support
SIGNIN_ALERT_THROTTLE_MINUTES=360
SIGNIN_ALERT_FINGERPRINT_SECRET=
SDK_API_KEY_CLEANUP_CRON=0 0 * * *
ACADEMY_SDK_CATALOG_CACHE_TTL_MS=60000
COURSE_PDF_MAX_CONCURRENT=2
COURSE_PDF_TIMEOUT_MS=30000
PUPPETEER_NO_SANDBOX=true

# Clerk Billing
# Create the webhook in Clerk Dashboard > Configure > Webhooks.
# Get the frontend keys from Clerk Dashboard > API keys > Quick copy > JavaScript.
CLERK_WEBHOOK_SECRET=
CLERK_BILLING_PLAN_ID=cplan_3E6vfLRRJBC9t4HfgdUWZJuLPuh
CLERK_BILLING_PRO_PLAN_ID=
CLERK_BILLING_PREMIUM_PLAN_ID=
CLERK_BILLING_PLAN_PERIOD=month
CLERK_BILLING_PORTAL_URL=
